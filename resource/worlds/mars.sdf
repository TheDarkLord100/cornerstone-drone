<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="mars">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <!-- Mars-like lighting — dimmer, reddish sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.8 0.6 0.5 1</diffuse>
      <specular>0.2 0.15 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ambient reddish tint -->
    <scene>
      <ambient>0.4 0.3 0.2 1</ambient>
      <background>0.7 0.4 0.2 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Mars Gale Crater Patch 1 -->
    <include>
      <uri>model://Mars Gale Crater Patch 1</uri>
      <name>crater_patch_1</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Mars Gale Crater Patch 2 — offset so they tile -->
    <include>
      <uri>model://Mars Gale Crater Patch 2</uri>
      <name>crater_patch_2</name>
      <pose>50 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>